function ExtractPOMaster() {
  const sourceSpreadsheetId = '1xb76Hf1uV600UyCIuev1iBupolLWR9V2KVx9FffK3SU';
  const sourceSheetName = 'Data List';
  const targetSheetName = 'Current PO Master';

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const targetSheet = ss.getSheetByName(targetSheetName);
  if (!targetSheet) throw new Error(`Target sheet not found: ${targetSheetName}`);

  // TARGET Current PO Master ← SOURCE Data List
  // Preserve every source item row with a PO NO. Do not group or aggregate.
  const columnMapping = {
    'DATE PREPARED': 'DATE PREPARED (PO)',
    'CAF NO.': 'CAF NO.',
    'PO. NO.': 'PO NO.',
    'ITEM DESCRIPTION': 'ITEM DESCRIPTION',
    'PROJECT TITLE': 'PROJECT TITLE',
    'AMOUNT': 'PO TOTAL COST',
    'PR NO.': 'PR NO.',
    'END-USER': 'END-USER',
    'SUPPLIER': 'SUPPLIER',
    'METHOD': 'PROCUREMENT METHOD PO',
    'PROJECT ID': 'PROJECT ID',
    'PHILGEPS REFERENCE NO.': 'PHILGEPS REFERENCE NO.',
    'FUND SOURCE': 'SOURCE OF FUNDS',
    'CATEGORY': 'CATEGORY'
  };

  const getColIndex = (headers, name) =>
    headers.findIndex(h => h != null && String(h).trim().toUpperCase() === name.trim().toUpperCase());

  const sourceSheet = SpreadsheetApp.openById(sourceSpreadsheetId).getSheetByName(sourceSheetName);
  if (!sourceSheet) throw new Error(`Source sheet not found: ${sourceSheetName}`);

  const sourceData = sourceSheet.getDataRange().getValues();
  if (sourceData.length < 2) {
    Logger.log('Data List contains no data rows.');
    return;
  }

  const targetData = targetSheet.getDataRange().getValues();
  if (targetData.length < 1) throw new Error('Current PO Master has no header row.');

  const sourceHeader = sourceData[0];
  const sourceRows = sourceData.slice(1);
  const targetHeader = targetData[0];
  const targetRows = targetData.slice(1);

  const sourcePoCol = getColIndex(sourceHeader, 'PO NO.');
  const targetPoCol = getColIndex(targetHeader, 'PO. NO.');

  if (sourcePoCol === -1) throw new Error('Data List: PO NO. column was not found.');
  if (targetPoCol === -1) throw new Error('Current PO Master: PO. NO. column was not found.');

  const mappedColumns = Object.entries(columnMapping).map(([targetColName, sourceColName]) => ({
    targetColName,
    sourceColName,
    targetIndex: getColIndex(targetHeader, targetColName),
    sourceIndex: getColIndex(sourceHeader, sourceColName)
  }));

  const missingSource = mappedColumns.filter(m => m.sourceIndex === -1).map(m => m.sourceColName);
  const missingTarget = mappedColumns.filter(m => m.targetIndex === -1).map(m => m.targetColName);

  if (missingSource.length) {
    throw new Error(`Data List missing source columns: ${missingSource.join(', ')}`);
  }
  if (missingTarget.length) {
    throw new Error(`Current PO Master missing target columns: ${missingTarget.join(', ')}`);
  }

  const sourceRowsWithPO = sourceRows.filter(row => {
    const po = row[sourcePoCol];
    return po !== '' && po != null && String(po).trim() !== '';
  });

  const sourceRowsWithoutPO = sourceRows.length - sourceRowsWithPO.length;

  // Build every detailed item row in memory first.
  const rowsToWrite = sourceRowsWithPO.map(sourceRow => {
    const targetRow = Array(targetHeader.length).fill('');
    mappedColumns.forEach(({sourceIndex, targetIndex}) => {
      targetRow[targetIndex] = sourceRow[sourceIndex];
    });
    return targetRow;
  });

  // Match existing detailed records using PO NO. + ITEM DESCRIPTION + source row occurrence.
  // The occurrence counter prevents duplicate PO/item descriptions from overwriting one another.
  const itemTargetCol = getColIndex(targetHeader, 'ITEM DESCRIPTION');
  const existingRowsByBaseKey = new Map();

  targetRows.forEach((row, i) => {
    const po = row[targetPoCol];
    if (po === '' || po == null || String(po).trim() === '') return;

    const item = itemTargetCol === -1 ? '' : row[itemTargetCol];
    const baseKey = `${String(po).trim().toUpperCase()}||${String(item ?? '').trim().toUpperCase()}`;

    if (!existingRowsByBaseKey.has(baseKey)) existingRowsByBaseKey.set(baseKey, []);
    existingRowsByBaseKey.get(baseKey).push(i + 2);
  });

  const occurrenceCounters = new Map();
  const rowsToUpdate = [];
  const rowsToAppend = [];

  rowsToWrite.forEach(sourceMappedRow => {
    const po = sourceMappedRow[targetPoCol];
    const item = itemTargetCol === -1 ? '' : sourceMappedRow[itemTargetCol];
    const baseKey = `${String(po).trim().toUpperCase()}||${String(item ?? '').trim().toUpperCase()}`;
    const occurrence = (occurrenceCounters.get(baseKey) || 0);
    occurrenceCounters.set(baseKey, occurrence + 1);

    const existingRows = existingRowsByBaseKey.get(baseKey) || [];
    const existingRowNumber = existingRows[occurrence];

    if (existingRowNumber) {
      rowsToUpdate.push({rowNumber: existingRowNumber, rowData: sourceMappedRow});
    } else {
      rowsToAppend.push(sourceMappedRow);
    }
  });

  // Update only rows that actually changed.
  rowsToUpdate.forEach(({rowNumber, rowData}) => {
    const currentRow = targetSheet.getRange(rowNumber, 1, 1, targetHeader.length).getValues()[0];
    let changed = false;

    mappedColumns.forEach(({targetIndex}) => {
      if (String(currentRow[targetIndex]) !== String(rowData[targetIndex])) {
        currentRow[targetIndex] = rowData[targetIndex];
        changed = true;
      }
    });

    if (changed) {
      targetSheet.getRange(rowNumber, 1, 1, targetHeader.length).setValues([currentRow]);
    }
  });

  const updatedCount = rowsToUpdate.length;

  // Fill existing blank rows first.
  const availableRows = [];
  for (let i = 0; i < targetRows.length; i++) {
    const poValue = targetRows[i][targetPoCol];
    if (poValue === '' || poValue == null || String(poValue).trim() === '') {
      availableRows.push(i + 2);
    }
  }

  const rowsForBlankSlots = Math.min(rowsToAppend.length, availableRows.length);
  for (let i = 0; i < rowsForBlankSlots; i++) {
    targetSheet.getRange(availableRows[i], 1, 1, targetHeader.length).setValues([rowsToAppend[i]]);
  }

  const remainingRows = rowsToAppend.slice(rowsForBlankSlots);
  if (remainingRows.length) {
    const startRow = Math.max(targetSheet.getLastRow() + 1, 2);
    const requiredLastRow = startRow + remainingRows.length - 1;

    if (requiredLastRow > targetSheet.getMaxRows()) {
      targetSheet.insertRowsAfter(targetSheet.getMaxRows(), requiredLastRow - targetSheet.getMaxRows());
    }

    targetSheet.getRange(startRow, 1, remainingRows.length, targetHeader.length).setValues(remainingRows);
  }

  Logger.log('Data List → Current PO Master detailed extraction complete.');
  Logger.log(`Source Data List rows: ${sourceRows.length}`);
  Logger.log(`Source rows with PO NO.: ${sourceRowsWithPO.length}`);
  Logger.log(`Source rows without PO NO. (skipped): ${sourceRowsWithoutPO}`);
  Logger.log(`Rows updated successfully: ${updatedCount}`);
  Logger.log(`Rows appended successfully: ${rowsToAppend.length}`);
  Logger.log('ITEM DESCRIPTION and CATEGORY are preserved in Current PO Master.');
  Logger.log('No grouping or PO TOTAL COST aggregation is performed.');

  SpreadsheetApp.flush();
}
