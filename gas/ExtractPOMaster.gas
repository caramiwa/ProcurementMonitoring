function ExtractPOMaster() {
  const sourceSpreadsheetId = '1xb76Hf1uV600UyCIuev1iBupolLWR9V2KVx9FffK3SU';
  const sourceSheetName = 'Data List';
  const targetSheetName = 'Current PO Master';

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const targetSheet = ss.getSheetByName(targetSheetName);
  if (!targetSheet) throw new Error(`Target sheet not found: ${targetSheetName}`);

  // TARGET Current PO Master ← SOURCE Data List
  // Data List is READ ONLY. Nothing is ever written back to it.
  const columnMapping = {
    'DATE PREPARED': 'DATE PREPARED (PO)',
    'CAF NO.': 'CAF NO.',
    'PO. NO.': 'PO NO.',
    'ITEM DESCRIPTION': 'ITEM DESCRIPTION',
    'PROJECT TITLE': 'PROJECT TITLE',
    'AMOUNT': 'PO TOTAL COST',
    'PR NO.': 'PR NO.',
    'END-USER': 'END-USER',
    'SUPPLIER': 'SUPPLIER',
    'METHOD': 'PROCUREMENT METHOD PO',
    'PROJECT ID': 'PROJECT ID',
    'PHILGEPS REFERENCE NO.': 'PHILGEPS REFERENCE NO.',
    'FUND SOURCE': 'SOURCE OF FUNDS',
    'CATEGORY': 'CATEGORY'
  };

  const normalize = value => String(value ?? '').trim();
  const normalizeKey = value => normalize(value).toUpperCase();
  const getColIndex = (headers, name) =>
    headers.findIndex(h => normalizeKey(h) === normalizeKey(name));

  // Extract only the text inside parentheses for PROJECT ID.
  // Example: 0006 (LR-01-0006) → LR-01-0006
  const cleanProjectId = value => {
    const text = normalize(value);
    const match = text.match(/\(([^()]*)\)/);
    return match ? match[1].trim() : text;
  };

  const sourceSheet = SpreadsheetApp.openById(sourceSpreadsheetId).getSheetByName(sourceSheetName);
  if (!sourceSheet) throw new Error(`Source sheet not found: ${sourceSheetName}`);

  const sourceData = sourceSheet.getDataRange().getValues();
  const targetData = targetSheet.getDataRange().getValues();

  if (targetData.length < 1) throw new Error('Current PO Master has no header row.');

  const sourceHeader = sourceData.length ? sourceData[0] : [];
  const sourceRows = sourceData.length > 1 ? sourceData.slice(1) : [];
  const targetHeader = targetData[0];
  const existingTargetRows = targetData.length > 1 ? targetData.slice(1) : [];

  const sourcePoCol = getColIndex(sourceHeader, 'PO NO.');
  const targetPoCol = getColIndex(targetHeader, 'PO. NO.');
  const targetIdCol = getColIndex(targetHeader, 'PO ITEM ID');
  const targetSignatureCol = getColIndex(targetHeader, 'SOURCE ROW SIGNATURE');

  if (sourcePoCol === -1) throw new Error('Data List: PO NO. column was not found.');
  if (targetPoCol === -1) throw new Error('Current PO Master: PO. NO. column was not found.');
  if (targetIdCol === -1) throw new Error('Current PO Master: PO ITEM ID column was not found.');
  if (targetSignatureCol === -1) throw new Error('Current PO Master: SOURCE ROW SIGNATURE column was not found.');

  const mappedColumns = Object.entries(columnMapping).map(([targetColName, sourceColName]) => ({
    targetColName,
    sourceColName,
    targetIndex: getColIndex(targetHeader, targetColName),
    sourceIndex: getColIndex(sourceHeader, sourceColName)
  }));

  const missingSource = mappedColumns.filter(m => m.sourceIndex === -1).map(m => m.sourceColName);
  const missingTarget = mappedColumns.filter(m => m.targetIndex === -1).map(m => m.targetColName);

  if (missingSource.length) {
    throw new Error(`Data List missing source columns: ${missingSource.join(', ')}`);
  }
  if (missingTarget.length) {
    throw new Error(`Current PO Master missing target columns: ${missingTarget.join(', ')}`);
  }

  const sourceRowsWithPO = [];
  let sourceRowsWithoutPO = 0;

  sourceRows.forEach((row, index) => {
    if (normalize(row[sourcePoCol]) === '') {
      sourceRowsWithoutPO++;
      return;
    }

    // Google Sheets row number. This is the identity of the source record for
    // synchronization; it is stored only in Current PO Master.
    sourceRowsWithPO.push({
      row,
      sourceRowNumber: index + 2
    });
  });

  // Existing records are indexed by SOURCE ROW SIGNATURE so that a subsequent
  // trigger run updates the existing PO ITEM ID instead of creating a duplicate.
  const existingBySignature = new Map();
  let maxItemSequence = 0;

  existingTargetRows.forEach(existingRow => {
    const signature = normalize(existingRow[targetSignatureCol]);
    const itemId = normalize(existingRow[targetIdCol]);

    if (signature) existingBySignature.set(signature, existingRow);

    // Recover the highest numeric suffix from existing IDs, e.g. PO-001-027.
    const match = itemId.match(/-(\d+)$/);
    if (match) maxItemSequence = Math.max(maxItemSequence, Number(match[1]));
  });

  // If this is the first synchronization after adding SOURCE ROW SIGNATURE,
  // existing records may not have signatures. Match them by their current row
  // position so their existing PO ITEM IDs are preserved.
  const existingByPosition = new Map();
  existingTargetRows.forEach((existingRow, index) => {
    const itemId = normalize(existingRow[targetIdCol]);
    if (itemId) existingByPosition.set(index + 2, existingRow);
  });

  const occurrenceByPO = new Map();
  const outputRows = [];
  let updatedCount = 0;
  let appendedCount = 0;

  sourceRowsWithPO.forEach(({row, sourceRowNumber}) => {
    const po = normalize(row[sourcePoCol]);
    const poKey = normalizeKey(po);
    const signature = `DataList:${sourceRowNumber}`;

    const occurrence = (occurrenceByPO.get(poKey) || 0) + 1;
    occurrenceByPO.set(poKey, occurrence);

    let existingRecord = existingBySignature.get(signature);

    // Initial migration: the old records were created before SOURCE ROW
    // SIGNATURE existed. Preserve their existing PO ITEM ID by position.
    if (!existingRecord) {
      existingRecord = existingByPosition.get(sourceRowNumber);
    }

    let poItemId = existingRecord ? normalize(existingRecord[targetIdCol]) : '';

    if (poItemId) {
      updatedCount++;
    } else {
      maxItemSequence++;
      poItemId = `${po}-${String(maxItemSequence).padStart(3, '0')}`;
      appendedCount++;
    }

    const targetRow = Array(targetHeader.length).fill('');

    mappedColumns.forEach(({targetColName, sourceIndex, targetIndex}) => {
      let value = row[sourceIndex];

      if (targetColName === 'PROJECT ID') {
        value = cleanProjectId(value);
      }

      targetRow[targetIndex] = value;
    });

    targetRow[targetIdCol] = poItemId;
    targetRow[targetSignatureCol] = signature;

    outputRows.push(targetRow);
  });

  // Write the synchronized output in one batch. Existing PO ITEM IDs are
  // preserved; changed source values, including PROJECT ID, are refreshed.
  const outputStartRow = 2;
  const requiredLastRow = outputStartRow + outputRows.length - 1;

  if (outputRows.length > 0 && requiredLastRow > targetSheet.getMaxRows()) {
    targetSheet.insertRowsAfter(
      targetSheet.getMaxRows(),
      requiredLastRow - targetSheet.getMaxRows()
    );
  }

  const existingDataRowCount = Math.max(targetSheet.getLastRow() - 1, 0);
  if (existingDataRowCount > 0) {
    targetSheet.getRange(2, 1, existingDataRowCount, targetHeader.length).clearContent();
  }

  if (outputRows.length > 0) {
    targetSheet.getRange(outputStartRow, 1, outputRows.length, targetHeader.length)
      .setValues(outputRows);
  }

  // Remove stale generated rows if the source now contains fewer PO records.
  const clearStartRow = outputRows.length + 2;
  const rowsToClear = targetSheet.getMaxRows() - clearStartRow + 1;
  if (rowsToClear > 0) {
    targetSheet.getRange(clearStartRow, 1, rowsToClear, targetHeader.length).clearContent();
  }

  Logger.log('Data List → Current PO Master synchronization complete.');
  Logger.log(`Source Data List rows: ${sourceRows.length}`);
  Logger.log(`Source rows with PO NO.: ${sourceRowsWithPO.length}`);
  Logger.log(`Source rows without PO NO. (skipped): ${sourceRowsWithoutPO}`);
  Logger.log(`Current PO Master rows synchronized: ${outputRows.length}`);
  Logger.log(`Existing rows updated: ${updatedCount}`);
  Logger.log(`New rows appended/generated: ${appendedCount}`);
  Logger.log('PROJECT ID is normalized to the value inside parentheses.');
  Logger.log('PO ITEM ID is preserved for existing source rows and generated for new rows.');
  Logger.log('SOURCE ROW SIGNATURE is stored only in Current PO Master.');
  Logger.log('Data List remains read-only.');

  SpreadsheetApp.flush();
}
