function updatePO2026_FromAPP() {
  const sourceSpreadsheetId = '1xb76Hf1uV600UyCIuev1iBupolLWR9V2KVx9Fff9V2KVx9FffK3SU'.replace('9V2KVx9Fff', '9V2KVx9Fff');
  const sourceSheetName = 'Data List';
  const targetSheetName = 'PO 2026';

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const targetSheet = ss.getSheetByName(targetSheetName);
  if (!targetSheet) throw new Error(`Target sheet not found: ${targetSheetName}`);

  // TARGET PO 2026 → SOURCE Data List
  const columnMapping = {
    'DATE PREPARED': 'DATE PREPARED (PO)',
    'CAF NO.': 'CAF NO.',
    'PO. NO.': 'PO NO.',
    'ITEM DESCIRPTION': 'ITEM DESCRIPTION',
    'PROJECT TITLE': 'PROJECT TITLE',
    'AMOUNT': 'PO TOTAL COST',
    'PR NO.': 'PR NO.',
    'END-USER': 'END-USER',
    'SUPPLIER': 'SUPPLIER',
    'METHOD': 'PROCUREMENT METHOD PO',
    'PROJECT ID': 'PROJECT ID',
    'PHILGEPS REFERENCE NO.': 'PHILGEPS REFERENCE NO.',
    'FUND SOURCE': 'SOURCE OF FUNDS'
  };

  const getColIndex = (headers, name) =>
    headers.findIndex(h => h != null && String(h).trim().toUpperCase() === name.trim().toUpperCase());

  const sourceSheet = SpreadsheetApp.openById(sourceSpreadsheetId).getSheetByName(sourceSheetName);
  if (!sourceSheet) throw new Error(`Source sheet not found: ${sourceSheetName}`);

  const sourceData = sourceSheet.getDataRange().getValues();
  if (sourceData.length < 2) {
    Logger.log('Data List contains no data rows.');
    return;
  }

  const sourceHeader = sourceData[0];
  const sourceRows = sourceData.slice(1);
  const targetData = targetSheet.getDataRange().getValues();
  if (!targetData.length) throw new Error('PO 2026 has no header row.');

  const targetHeader = targetData[0];
  const targetRows = targetData.slice(1);

  const sourcePoCol = getColIndex(sourceHeader, 'PO NO.');
  const targetPoCol = getColIndex(targetHeader, 'PO. NO.');

  if (sourcePoCol === -1) throw new Error('Data List: PO NO. column was not found.');
  if (targetPoCol === -1) throw new Error('PO 2026: PO. NO. column was not found.');

  const mappedColumns = Object.entries(columnMapping).map(([targetColName, sourceColName]) => ({
    targetColName,
    sourceColName,
    targetIndex: getColIndex(targetHeader, targetColName),
    sourceIndex: getColIndex(sourceHeader, sourceColName)
  }));

  const missingSource = mappedColumns.filter(m => m.sourceIndex === -1).map(m => m.sourceColName);
  const missingTarget = mappedColumns.filter(m => m.targetIndex === -1).map(m => m.targetColName);

  if (missingSource.length) throw new Error(`Data List missing source columns: ${missingSource.join(', ')}`);
  if (missingTarget.length) throw new Error(`PO 2026 missing target columns: ${missingTarget.join(', ')}`);

  // Group source rows by PO. Multiple source rows can belong to one PO.
  const sourceByPO = new Map();
  sourceRows.forEach(row => {
    const poRaw = row[sourcePoCol];
    if (poRaw === '' || poRaw == null) return;
    const poKey = String(poRaw).trim().toUpperCase();
    if (!sourceByPO.has(poKey)) sourceByPO.set(poKey, []);
    sourceByPO.get(poKey).push(row);
  });

  // Find existing PO rows in the target.
  const targetRowByPO = new Map();
  targetRows.forEach((row, i) => {
    const poRaw = row[targetPoCol];
    if (poRaw === '' || poRaw == null) return;
    targetRowByPO.set(String(poRaw).trim().toUpperCase(), i + 2);
  });

  const buildValues = rows => {
    const values = {};

    mappedColumns.forEach(({targetColName, sourceIndex, targetIndex}) => {
      if (targetColName === 'AMOUNT') {
        values[targetIndex] = rows.reduce((sum, row) => {
          const value = row[sourceIndex];
          if (typeof value === 'number') return sum + value;
          const cleaned = String(value ?? '').replace(/[^0-9.-]/g, '');
          return sum + (cleaned ? parseFloat(cleaned) || 0 : 0);
        }, 0);
      } else {
        const uniqueValues = [...new Set(
          rows.map(row => row[sourceIndex])
            .filter(value => value !== '' && value != null)
            .map(value => String(value).trim())
        )];
        values[targetIndex] = uniqueValues.join(', ');
      }
    });

    return values;
  };

  let updateCount = 0;
  const rowsToWrite = [];

  sourceByPO.forEach((sourceGroup, poKey) => {
    const values = buildValues(sourceGroup);

    if (targetRowByPO.has(poKey)) {
      const targetRowNumber = targetRowByPO.get(poKey);
      const currentRow = targetSheet.getRange(targetRowNumber, 1, 1, targetHeader.length).getValues()[0];
      let changed = false;

      Object.entries(values).forEach(([index, newValue]) => {
        const i = Number(index);
        if (String(currentRow[i]) !== String(newValue)) {
          currentRow[i] = newValue;
          changed = true;
        }
      });

      if (changed) {
        targetSheet.getRange(targetRowNumber, 1, 1, targetHeader.length).setValues([currentRow]);
        updateCount++;
      }
    } else {
      const newRow = Array(targetHeader.length).fill('');
      Object.entries(values).forEach(([index, value]) => {
        newRow[Number(index)] = value;
      });
      rowsToWrite.push({ poKey, row: newRow });
    }
  });

  // Write new POs into the first available blank PO rows.
  // We deliberately do not copy or set formatting; this script writes data only.
  const availableRows = [];
  for (let i = 0; i < targetRows.length; i++) {
    const poValue = targetRows[i][targetPoCol];
    if (poValue === '' || poValue == null) {
      availableRows.push(i + 2);
    }
  }

  if (rowsToWrite.length > availableRows.length) {
    const requiredLastRow = 1 + rowsToWrite.length + targetRows.length;
    targetSheet.insertRowsAfter(targetSheet.getMaxRows(), requiredLastRow - targetSheet.getMaxRows());

    for (let row = targetRows.length + 2; row <= requiredLastRow; row++) {
      availableRows.push(row);
    }
  }

  rowsToWrite.forEach((item, index) => {
    const rowNumber = availableRows[index];
    targetSheet.getRange(rowNumber, 1, 1, targetHeader.length).setValues([item.row]);
  });

  Logger.log('Data List → PO 2026 extraction complete.');
  Logger.log(`Source Data List rows: ${sourceRows.length}`);
  Logger.log(`Unique POs found: ${sourceByPO.size}`);
  Logger.log(`Rows written to available blank rows: ${rowsToWrite.length}`);
  Logger.log(`Rows updated successfully: ${updateCount}`);

  SpreadsheetApp.flush();
}
