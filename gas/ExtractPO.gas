function ExtractPO() {
  const sourceSheetName = 'Current PO Master';
  const targetSheetName = 'Current PO';

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = ss.getSheetByName(sourceSheetName);
  const targetSheet = ss.getSheetByName(targetSheetName);

  if (!sourceSheet) throw new Error(`Source sheet not found: ${sourceSheetName}`);
  if (!targetSheet) throw new Error(`Target sheet not found: ${targetSheetName}`);

  // TARGET PO 2026 ← SOURCE PO Master 2026
  // One record per unique PO. ITEM DESCRIPTION is intentionally excluded.
  const columnMapping = {
    'DATE PREPARED': 'DATE PREPARED',
    'CAF NO.': 'CAF NO.',
    'PO. NO.': 'PO. NO.',
    'PROJECT TITLE': 'PROJECT TITLE',
    'AMOUNT': 'PO TOTAL COST',
    'PR NO.': 'PR NO.',
    'END-USER': 'END-USER',
    'SUPPLIER': 'SUPPLIER',
    'METHOD': 'METHOD',
    'PROJECT ID': 'PROJECT ID',
    'PHILGEPS REFERENCE NO.': 'PHILGEPS REFERENCE NO.',
    'FUND SOURCE': 'FUND SOURCE',
    'CATEGORY': 'CATEGORY'
  };

  const getColIndex = (headers, name) =>
    headers.findIndex(h => h != null && String(h).trim().toUpperCase() === name.trim().toUpperCase());

  const sourceData = sourceSheet.getDataRange().getValues();
  if (sourceData.length < 2) {
    Logger.log('PO Master 2026 contains no data rows.');
    return;
  }

  const targetData = targetSheet.getDataRange().getValues();
  if (targetData.length < 1) throw new Error('PO 2026 has no header row.');

  const sourceHeader = sourceData[0];
  const sourceRows = sourceData.slice(1);
  const targetHeader = targetData[0];
  const targetRows = targetData.slice(1);

  const sourcePoCol = getColIndex(sourceHeader, 'PO. NO.');
  const targetPoCol = getColIndex(targetHeader, 'PO. NO.');

  if (sourcePoCol === -1) throw new Error(`${sourceSheetName}: PO. NO. column was not found.`);
  if (targetPoCol === -1) throw new Error(`${targetSheetName}: PO. NO. column was not found.`);

  const mappedColumns = Object.entries(columnMapping).map(([targetColName, sourceColName]) => ({
    targetColName,
    sourceColName,
    targetIndex: getColIndex(targetHeader, targetColName),
    sourceIndex: getColIndex(sourceHeader, sourceColName)
  }));

  const missingSource = mappedColumns.filter(m => m.sourceIndex === -1).map(m => m.sourceColName);
  const missingTarget = mappedColumns.filter(m => m.targetIndex === -1).map(m => m.targetColName);

  if (missingSource.length) {
    throw new Error(`${sourceSheetName} missing source columns: ${missingSource.join(', ')}`);
  }
  if (missingTarget.length) {
    throw new Error(`${targetSheetName} missing target columns: ${missingTarget.join(', ')}`);
  }

  // Group the detailed PO Master rows by PO NO.
  // PO Master is the detailed item-level dataset, so ExtractPO no longer reads Data List.
  const poGroups = new Map();

  sourceRows.forEach(row => {
    const poRaw = row[sourcePoCol];
    if (poRaw === '' || poRaw == null || String(poRaw).trim() === '') return;

    const poKey = String(poRaw).trim().toUpperCase();
    if (!poGroups.has(poKey)) poGroups.set(poKey, []);
    poGroups.get(poKey).push(row);
  });

  // Build one PO-level record per PO.
  // AMOUNT is the sum of PO TOTAL COST across all detailed rows belonging to the PO.
  const buildPOMasterRow = rows => {
    const targetRow = Array(targetHeader.length).fill('');

    mappedColumns.forEach(({targetColName, sourceIndex, targetIndex}) => {
      if (targetColName === 'AMOUNT') {
        targetRow[targetIndex] = rows.reduce((sum, row) => {
          const value = row[sourceIndex];
          if (typeof value === 'number') return sum + value;

          const cleaned = String(value ?? '').replace(/[^0-9.-]/g, '');
          return sum + (cleaned ? parseFloat(cleaned) || 0 : 0);
        }, 0);
      } else {
        const uniqueValues = [...new Set(
          rows
            .map(row => row[sourceIndex])
            .filter(value => value !== '' && value != null)
            .map(value => String(value).trim())
        )];

        targetRow[targetIndex] = uniqueValues.join(', ');
      }
    });

    return targetRow;
  };

  const outputRows = [...poGroups.values()].map(buildPOMasterRow);

  // Index existing PO 2026 rows by PO NO. for updates.
  const targetRowByPO = new Map();
  targetRows.forEach((row, i) => {
    const poRaw = row[targetPoCol];
    if (poRaw === '' || poRaw == null || String(poRaw).trim() === '') return;
    targetRowByPO.set(String(poRaw).trim().toUpperCase(), i + 2);
  });

  // Prepare all changes in memory first. This avoids thousands of individual
  // spreadsheet writes and makes the extraction substantially faster.
  const rowsToUpdate = [];
  const rowsToAppend = [];

  outputRows.forEach(rowData => {
    const poKey = String(rowData[targetPoCol]).trim().toUpperCase();
    const existingRowNumber = targetRowByPO.get(poKey);

    if (existingRowNumber) {
      rowsToUpdate.push({rowNumber: existingRowNumber, rowData});
    } else {
      rowsToAppend.push(rowData);
    }
  });

  // Update existing rows in batches by writing contiguous ranges where possible.
  // For simplicity and reliability, each update is still limited to the actual row,
  // while all new rows are written in one batch below.
  rowsToUpdate.forEach(({rowNumber, rowData}) => {
    targetSheet.getRange(rowNumber, 1, 1, targetHeader.length).setValues([rowData]);
  });

  // Fill existing blank rows before adding new sheet rows.
  const availableRows = [];
  for (let i = 0; i < targetRows.length; i++) {
    const poValue = targetRows[i][targetPoCol];
    if (poValue === '' || poValue == null || String(poValue).trim() === '') {
      availableRows.push(i + 2);
    }
  }

  const rowsForBlankSlots = Math.min(rowsToAppend.length, availableRows.length);
  for (let i = 0; i < rowsForBlankSlots; i++) {
    targetSheet.getRange(availableRows[i], 1, 1, targetHeader.length).setValues([rowsToAppend[i]]);
  }

  const remainingRows = rowsToAppend.slice(rowsForBlankSlots);
  if (remainingRows.length) {
    const startRow = Math.max(targetSheet.getLastRow() + 1, 2);
    const requiredLastRow = startRow + remainingRows.length - 1;
    if (requiredLastRow > targetSheet.getMaxRows()) {
      targetSheet.insertRowsAfter(targetSheet.getMaxRows(), requiredLastRow - targetSheet.getMaxRows());
    }
    targetSheet.getRange(startRow, 1, remainingRows.length, targetHeader.length).setValues(remainingRows);
  }

  Logger.log('PO Master 2026 → PO 2026 aggregation complete.');
  Logger.log(`Source PO Master 2026 rows: ${sourceRows.length}`);
  Logger.log(`Unique POs found: ${poGroups.size}`);
  Logger.log(`Rows updated successfully: ${rowsToUpdate.length}`);
  Logger.log(`Rows appended successfully: ${rowsToAppend.length}`);
  Logger.log('ITEM DESCRIPTION is excluded from PO 2026.');
  Logger.log('PO TOTAL COST is summed across all detailed PO Master rows belonging to each PO.');

  SpreadsheetApp.flush();
}
