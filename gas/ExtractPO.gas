function updatePO2026_FromAPP() {
  const sourceSpreadsheetId = '1xb76Hf1uV600UyCIuev1iBupolLWR9V2KVx9FffK3SU';
  const sourceSheetName = 'Data List';
  const targetSheetName = 'PO 2026';

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const targetSheet = ss.getSheetByName(targetSheetName);
  if (!targetSheet) throw new Error(`Target sheet not found: ${targetSheetName}`);

  // TARGET PO 2026 → SOURCE Data List
  const columnMapping = {
    'DATE PREPARED': 'DATE PREPARED (PO)',
    'CAF NO.': 'CAF NO.',
    'PO. NO.': 'PO NO.',
    'ITEM DESCIRPTION': 'ITEM DESCRIPTION',
    'PROJECT TITLE': 'PROJECT TITLE',
    'AMOUNT': 'PO TOTAL COST',
    'PR NO.': 'PR NO.',
    'END-USER': 'END-USER',
    'SUPPLIER': 'SUPPLIER',
    'METHOD': 'PROCUREMENT METHOD PO',
    'PROJECT ID': 'PROJECT ID',
    'PHILGEPS REFERENCE NO.': 'PHILGEPS REFERENCE NO.',
    'FUND SOURCE': 'SOURCE OF FUNDS'
  };

  const getColIndex = (headers, name) =>
    headers.findIndex(h => h != null && String(h).trim().toUpperCase() === name.trim().toUpperCase());

  const sourceSheet = SpreadsheetApp.openById(sourceSpreadsheetId).getSheetByName(sourceSheetName);
  if (!sourceSheet) throw new Error(`Source sheet not found: ${sourceSheetName}`);

  const sourceData = sourceSheet.getDataRange().getValues();
  if (sourceData.length < 2) {
    Logger.log('Data List contains no data rows.');
    return;
  }

  const sourceHeader = sourceData[0];
  const sourceRows = sourceData.slice(1);
  const targetData = targetSheet.getDataRange().getValues();
  if (!targetData.length) throw new Error('PO 2026 has no header row.');

  const targetHeader = targetData[0];
  const targetRows = targetData.slice(1);

  const sourcePoCol = getColIndex(sourceHeader, 'PO NO.');
  const targetPoCol = getColIndex(targetHeader, 'PO. NO.');

  if (sourcePoCol === -1) throw new Error('Data List: PO NO. column was not found.');
  if (targetPoCol === -1) throw new Error('PO 2026: PO. NO. column was not found.');

  const mappedColumns = Object.entries(columnMapping).map(([targetColName, sourceColName]) => ({
    targetColName,
    sourceColName,
    targetIndex: getColIndex(targetHeader, targetColName),
    sourceIndex: getColIndex(sourceHeader, sourceColName)
  }));

  const missingSource = mappedColumns.filter(m => m.sourceIndex === -1).map(m => m.sourceColName);
  const missingTarget = mappedColumns.filter(m => m.targetIndex === -1).map(m => m.targetColName);

  if (missingSource.length) throw new Error(`Data List missing source columns: ${missingSource.join(', ')}`);
  if (missingTarget.length) throw new Error(`PO 2026 missing target columns: ${missingTarget.join(', ')}`);

  // Preserve every source row that has a PO NO. Do NOT group or aggregate by PO.
  const sourceRowsWithPO = sourceRows.filter(row => {
    const po = row[sourcePoCol];
    return po !== '' && po != null && String(po).trim() !== '';
  });

  const sourceRowsWithoutPO = sourceRows.length - sourceRowsWithPO.length;

  // Build a target record for every source item row.
  const rowsToWrite = sourceRowsWithPO.map(sourceRow => {
    const targetRow = Array(targetHeader.length).fill('');

    mappedColumns.forEach(({sourceIndex, targetIndex}) => {
      targetRow[targetIndex] = sourceRow[sourceIndex];
    });

    return targetRow;
  });

  // Existing target rows are matched by the combination of PO NO. + ITEM DESCRIPTION.
  // This allows multiple items under the same PO to remain separate records.
  const targetRowByKey = new Map();
  targetRows.forEach((row, i) => {
    const po = row[targetPoCol];
    const itemCol = getColIndex(targetHeader, 'ITEM DESCRIPTION');
    const item = itemCol === -1 ? '' : row[itemCol];

    if (po !== '' && po != null && String(po).trim() !== '') {
      const key = `${String(po).trim().toUpperCase()}||${String(item ?? '').trim().toUpperCase()}`;
      if (!targetRowByKey.has(key)) targetRowByKey.set(key, i + 2);
    }
  });

  const itemTargetCol = getColIndex(targetHeader, 'ITEM DESCRIPTION');
  const rowsToAppend = [];
  let updateCount = 0;

  rowsToWrite.forEach(sourceMappedRow => {
    const po = sourceMappedRow[targetPoCol];
    const item = itemTargetCol === -1 ? '' : sourceMappedRow[itemTargetCol];
    const key = `${String(po).trim().toUpperCase()}||${String(item ?? '').trim().toUpperCase()}`;

    if (targetRowByKey.has(key)) {
      const targetRowNumber = targetRowByKey.get(key);
      const currentRow = targetSheet.getRange(targetRowNumber, 1, 1, targetHeader.length).getValues()[0];
      let changed = false;

      mappedColumns.forEach(({targetIndex}) => {
        if (String(currentRow[targetIndex]) !== String(sourceMappedRow[targetIndex])) {
          currentRow[targetIndex] = sourceMappedRow[targetIndex];
          changed = true;
        }
      });

      if (changed) {
        targetSheet.getRange(targetRowNumber, 1, 1, targetHeader.length).setValues([currentRow]);
        updateCount++;
      }
    } else {
      rowsToAppend.push(sourceMappedRow);
    }
  });

  // Fill existing blank rows first. We do not copy or alter formatting.
  const availableRows = [];
  for (let i = 0; i < targetRows.length; i++) {
    const poValue = targetRows[i][targetPoCol];
    if (poValue === '' || poValue == null || String(poValue).trim() === '') {
      availableRows.push(i + 2);
    }
  }

  if (rowsToAppend.length > availableRows.length) {
    const rowsNeeded = rowsToAppend.length - availableRows.length;
    const oldMaxRows = targetSheet.getMaxRows();
    targetSheet.insertRowsAfter(oldMaxRows, rowsNeeded);

    for (let row = oldMaxRows + 1; row <= oldMaxRows + rowsNeeded; row++) {
      availableRows.push(row);
    }
  }

  rowsToAppend.forEach((rowData, index) => {
    targetSheet.getRange(availableRows[index], 1, 1, targetHeader.length).setValues([rowData]);
  });

  Logger.log('Data List → PO 2026 line-item extraction complete.');
  Logger.log(`Source Data List rows: ${sourceRows.length}`);
  Logger.log(`Source rows with PO NO.: ${sourceRowsWithPO.length}`);
  Logger.log(`Source rows without PO NO. (skipped): ${sourceRowsWithoutPO}`);
  Logger.log(`Rows appended successfully: ${rowsToAppend.length}`);
  Logger.log(`Rows updated successfully: ${updateCount}`);
  Logger.log('Each Data List row is preserved as a separate PO 2026 item record; no grouping or amount aggregation is performed.');

  SpreadsheetApp.flush();
}
